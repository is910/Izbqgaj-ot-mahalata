// ASSET [roadTexture]: Асфалтова повърхност с петна и белези — може да се замени с tilable texture.
function makeRoadTex(){
  const t=texCanvas(256,256,(g,w,h)=>{
    g.fillStyle='#35322e';g.fillRect(0,0,w,h);
    for(let i=0;i<700;i++){g.fillStyle=Math.random()<.5?'rgba(255,255,255,.03)':'rgba(0,0,0,.07)';g.fillRect(R(0,w),R(0,h),2,2);}
