    g.fillStyle=v.cream;g.fillRect(0,0,w,54);
    g.fillStyle=v.base;g.fillRect(0,54,w,h-54);
    for(let i=0;i<8;i++){const x=26+i*58;
      g.fillStyle='#20262c';rr(g,x,12,44,34,4);g.fill();
      g.fillStyle='rgba(255,255,255,.18)';g.beginPath();g.moveTo(x+8,44);g.lineTo(x+22,12);g.lineTo(x+30,12);g.lineTo(x+16,44);g.closePath();g.fill();}
    g.fillStyle='rgba(0,0,0,.35)';g.fillRect(0,52,w,4);
    g.fillStyle='rgba(255,244,220,.85)';g.font='bold 17px Rubik, sans-serif';g.fillText('6-ТИ МИКРОРАЙОН',24,92);
    for(let i=0;i<14;i++){g.fillStyle=`rgba(${120+R(0,40)|0},${60+R(0,30)|0},30,${R(.15,.4)})`;g.beginPath();g.ellipse(R(0,w),R(84,128),R(4,16),R(3,10),R(0,3),0,7);g.fill();}
    g.fillStyle='#15130f';
    [95,345].forEach(cx=>{g.beginPath();g.arc(cx,h,30,PI,0);g.fill();});
  });
}
