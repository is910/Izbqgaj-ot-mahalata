/* ---------- Builders (всички заглушки с ASSET маркери) ---------- */
function M(c){return new THREE.MeshLambertMaterial({color:c});}
function ME(c){return new THREE.MeshLambertMaterial({color:c,emissive:c,emissiveIntensity:.4});}
function setShadow(g){g.traverse(o=>{if(o.isMesh)o.castShadow=true;});}

// ASSET [player]: Хлапак от махалата с дънки, клин и червено кепе — замени с анимиран character модел (run/jump/slide клипове).
function buildRunner(o){
  const g=new THREE.Group(),inner=new THREE.Group();g.add(inner);
  const torso=new THREE.Mesh(new THREE.BoxGeometry(.62,.72,.4),M(o.shirt));torso.position.y=1.16;inner.add(torso);
  const head=new THREE.Mesh(new THREE.BoxGeometry(.38,.38,.38),M(o.skin));head.position.y=1.78;inner.add(head);
  const cap=new THREE.Mesh(new THREE.BoxGeometry(.4,.13,.4),M(o.cap));cap.position.y=2.0;inner.add(cap);
  const brim=new THREE.Mesh(new THREE.BoxGeometry(.34,.05,.24),M(o.cap));brim.position.set(0,1.96,-.3);inner.add(brim);
  if(o.mustache){
    const mu=new THREE.Mesh(new THREE.BoxGeometry(.3,.07,.06),M('#2a1e15'));mu.position.set(0,1.7,-.21);inner.add(mu);
  }
  const mkLeg=sx=>{
    const lg=new THREE.Group();lg.position.set(sx,.82,0);
    const th=new THREE.Mesh(new THREE.BoxGeometry(.24,.84,.28),M(o.pants));th.position.y=-.42;lg.add(th);
    const bt=new THREE.Mesh(new THREE.BoxGeometry(.27,.14,.42),M(o.boots));bt.position.set(0,-.82,-.05);lg.add(bt);
    inner.add(lg);return lg;
  };
  const legL=mkLeg(-.17),legR=mkLeg(.17);
  const mkArm=sx=>{
    const ag=new THREE.Group();ag.position.set(sx*.44,1.44,0);
    const up=new THREE.Mesh(new THREE.BoxGeometry(.17,.62,.2),M(o.shirt));up.position.y=-.31;ag.add(up);
    const hd=new THREE.Mesh(new THREE.BoxGeometry(.15,.14,.17),M(o.skin));hd.position.y=-.66;ag.add(hd);
    if(o.stripes)for(let i=0;i<2;i++){
      const st=new THREE.Mesh(new THREE.BoxGeometry(.19,.025,.22),M('#e8e2d2'));st.position.y=-.06-.09*i;ag.add(st);
    }
    inner.add(ag);return ag;
  };
  const armL=mkArm(-1),armR=mkArm(1);
  setShadow(g);
  g.userData={inner,legL,legR,armL,armR};
  g.scale.setScalar(o.scale||1);
  return g;
}
function animateRunner(g,ph,k=1){
  const u=g.userData,s=Math.sin(ph);
  u.legL.rotation.x=s*.95*k;u.legR.rotation.x=-s*.95*k;
  u.armL.rotation.x=-s*k;u.armR.rotation.x=s*k;
  u.inner.rotation.x=-.12;
}

// ASSET [panelBlock]: Панелна кооперация (8 етажа, фуги, антенас на покрива) — фон отстрани на пътя.
function buildPanelBlock(){
  const g=new THREE.Group();
  const w=R(11,14),h=R(22,30),d=7;
  const tex=makePanelTexture();
  const side=M('#7c766a');
  const mats=[side,side,M('#6a655a'),M('#5a554c'),new THREE.MeshLambertMaterial({map:tex}),new THREE.MeshLambertMaterial({map:tex})];
  const body=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),mats);
  body.position.y=h/2;body.castShadow=true;body.receiveShadow=true;g.add(body);
  const roofBox=new THREE.Mesh(new THREE.BoxGeometry(w*.4,1.4,d*.5),M('#8a847a'));roofBox.position.set(R(-w*.2,w*.2),h+.7,0);g.add(roofBox);
  for(let i=0;i<3;i++){
    const ant=new THREE.Mesh(new THREE.CylinderGeometry(.04,.04,R(2,4),5),M('#3a352e'));
    ant.position.set(R(-w/3,w/3),h+1+ant.geometry.parameters.height/2,R(-d/3,d/3));g.add(ant);
  }
  return g;
}

