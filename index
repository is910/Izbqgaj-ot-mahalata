  const ring=new THREE.Mesh(new THREE.RingGeometry(.55,.7,26),new THREE.MeshBasicMaterial({color:pc?pc.colorHex:0xffffff,transparent:true,opacity:.55,side:THREE.DoubleSide}));
  ring.rotation.x=-PI/2;ring.position.y=.06;g.add(ring);
  g.userData.inner=inner;g.userData.ring=ring;
  return g;
}
