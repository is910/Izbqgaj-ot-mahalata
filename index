// ASSET [electricPole]: Двойка електрически стълбове с провиснали кабели през пътя + маратонки, хвърлени на тока.
function buildPolePair(){
  const g=new THREE.Group();
  const poleGeo=new THREE.CylinderGeometry(.11,.14,9,7);
  const armGeo=new THREE.BoxGeometry(2.6,.14,.14);
  [-5.7,5.7].forEach(x=>{
    const p=new THREE.Mesh(poleGeo,M('#4a443c'));p.position.set(x,4.5,0);p.castShadow=true;g.add(p);
    const a1=new THREE.Mesh(armGeo,M('#4a443c'));a1.position.set(x,8.4,0);g.add(a1);
    const a2=new THREE.Mesh(armGeo,M('#4a443c'));a2.position.set(x,7.5,0);a2.scale.x=.8;g.add(a2);
  });
  const lineMat=new THREE.LineBasicMaterial({color:0x241f1a,transparent:true,opacity:.85});
  const mkCable=(y,sag)=>{
    const c=new THREE.QuadraticBezierCurve3(new THREE.Vector3(-5.7,y,0),new THREE.Vector3(0,y-sag,0),new THREE.Vector3(5.7,y,0));
    return new THREE.Line(new THREE.BufferGeometry().setFromPoints(c.getPoints(12)),lineMat);
  };
  g.add(mkCable(8.4,2.1),mkCable(8.4,1.7),mkCable(7.5,1.5));
