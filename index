// ASSET [house]: Малка варосана къща с керемиден покрив, комин, ограда и градинско дръвче.
function buildHouse(side){
  const g=new THREE.Group();
  const w=4.6,d=4.2,h=3;
  const wallCol=CH(['#e8dcc4','#e3c987','#d8d8ca','#dab89a']);
  const body=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),M(wallCol));body.position.y=h/2;body.castShadow=true;body.receiveShadow=true;g.add(body);
  const roof=new THREE.Mesh(new THREE.ConeGeometry(3.7,1.9,4),M('#9c4a30'));
  roof.rotation.y=PI/4;roof.scale.set(1,.9,d/w);roof.position.y=h+.95;roof.castShadow=true;g.add(roof);
  const chim=new THREE.Mesh(new THREE.BoxGeometry(.5,1.1,.5),M('#8a5a3a'));chim.position.set(w*.24,h+1.2,d*.2);g.add(chim);
  const win=M('#2a3138');
  const fx=-side*(w/2+.02);
  [[-0.9,1.9],[0.9,1.9],[-0.9,1.0]].forEach(([wz,wy])=>{
    const winM=new THREE.Mesh(new THREE.BoxGeometry(.06,.6,.6),win);winM.position.set(fx,wy,wz);g.add(winM);
  });
  const door=new THREE.Mesh(new THREE.BoxGeometry(.06,1.5,.8),M('#5a3a22'));door.position.set(fx,.75,0);g.add(door);
  const fence=new THREE.Group();
  for(let i=0;i<7;i++){
    const p=new THREE.Mesh(new THREE.BoxGeometry(.09,.8,.09),M('#7a6a52'));
    p.position.set(side*(w/2+1.4),.4,-1.5+i*.5);fence.add(p);
  }
  const rail=new THREE.Mesh(new THREE.BoxGeometry(.08,.08,3.1),M('#7a6a52'));rail.position.set(side*(w/2+1.4),.62,0);fence.add(rail);
  g.add(fence);
  if(Math.random()<.7){
    const tr=buildTree();tr.position.set(-side*1.6,0,-1.4);tr.scale.setScalar(R(.8,1.2));g.add(tr);
  }
  return g;
}

