/* ---------- Canvas текстури-заглушки ---------- */
function texCanvas(w,h,draw){const c=document.createElement('canvas');c.width=w;c.height=h;const g=c.getContext('2d');draw(g,w,h);const t=new THREE.CanvasTexture(c);t.anisotropy=4;return t;}
function rr(g,x,y,w,h,r){g.beginPath();g.moveTo(x+r,y);g.arcTo(x+w,y,x+w,y+h,r);g.arcTo(x+w,y+h,x,y+h,r);g.arcTo(x,y+h,x,y,r);g.arcTo(x,y,x+w,y,r);g.closePath();}

// ASSET [panelTexture]: Текстура на панелна фасада — замени с истинска такава при качване на модели.
function makePanelTexture(){
  return texCanvas(256,512,(g,w,h)=>{
    g.fillStyle=CH(['#a19a8b','#9aa39f','#b3a68d','#8f8a80']);g.fillRect(0,0,w,h);
    for(let i=0;i<26;i++){g.fillStyle=`rgba(60,50,40,${R(.04,.12)})`;g.beginPath();g.ellipse(R(0,w),R(0,h),R(10,50),R(6,28),R(0,3),0,7);g.fill();}
    g.strokeStyle='rgba(0,0,0,.3)';g.lineWidth=2;
    for(let y=42;y<h;y+=85){g.beginPath();g.moveTo(0,y);g.lineTo(w,y);g.stroke();}
    for(let x=64;x<w;x+=64){g.beginPath();g.moveTo(x,0);g.lineTo(x,h);g.stroke();}
    for(let r0=0;r0<6;r0++)for(let c=0;c<4;c++){
      const x0=c*64+15,y0=r0*85+22;
      g.fillStyle='#4c463c';g.fillRect(x0-3,y0-3,40,50);
      const roll=Math.random();
      if(roll<.42){g.fillStyle='#242a30';g.fillRect(x0,y0,34,44);}
      else if(roll<.68){g.fillStyle='#ffc36a';g.fillRect(x0,y0,34,44);g.fillStyle='#ffe9b8';g.fillRect(x0+6,y0+8,10,10);}
      else{g.fillStyle='#d8cdb4';g.fillRect(x0,y0,34,44);g.fillStyle='#8a7f6a';g.fillRect(x0,y0,34,18);}
      if(Math.random()<.18){g.fillStyle='#7d7a72';g.fillRect(x0+8,y0+46,20,10);g.fillStyle='#5a574f';g.fillRect(x0+8,y0+46,20,3);}
      if(Math.random()<.3){g.fillStyle='rgba(50,40,30,.16)';g.fillRect(x0+R(0,30),y0+50,5,R(30,90));}
    }
    g.fillStyle='rgba(0,0,0,.25)';g.fillRect(0,h-38,w,38);
  });
}
