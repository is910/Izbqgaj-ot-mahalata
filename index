/* ---------- Патерни от препятствия ---------- */
function spawnPattern(){
  const z0=SPAWN_Z;
  const w=[];
  if(cfg.buses)w.push(['buses',diffKey==='imposs'?3:2]);
  w.push(['holes',1.4]);
  if(cfg.kilos){w.push(['kilos',2.4],['zig',1.2]);}
  if(cfg.powers.length)w.push(['power',.9]);
  if(diffKey==='hard')w.push(['mix',1.5]);
  if(diffKey==='imposs')w.push(['mix',2.2]);
  if(diffKey==='medium')w.push(['mix',.6]);
  const type=pickW(w);
  let gap=16;
  const lanes=shuffle([0,1,2]);
  switch(type){
    case 'buses':{
      const n=Math.min(cfg.busMax,Math.random()<.4?2:1)||1;
      for(let i=0;i<n;i++)spawnBus(lanes[i],z0-R(0,5));
      if(cfg.kilos)spawnKiloLine(lanes[n],z0+2,6);
      gap=R(15,21);break;}
    case 'holes':{
      const n=diffKey==='imposs'?2:(Math.random()<.5?2:1);
      for(let i=0;i<Math.min(n,2);i++){
        spawnHole(lanes[i],z0-R(0,2));
        if(diffKey!=='easy'&&Math.random()<.4)spawnHole(lanes[i],z0-R(6,10));
      }
      if(cfg.kilos)spawnKiloLine(lanes[2],z0,5);
      gap=R(13,17);break;}
    case 'kilos':spawnKiloLine(RI(0,2),z0,RI(6,9));gap=R(11,15);break;
    case 'zig':ZIG.forEach((ln,i)=>spawnKilo(ln,z0-i*2.3));gap=27;break;
    case 'power':{
      spawnPower(CH(cfg.powers),RI(0,2),z0);
      if(cfg.kilos)spawnKiloLine(RI(0,2),z0-3,4);
      gap=13;break;}
    case 'mix':{
      spawnBus(lanes[0],z0);
      spawnHole(lanes[1],z0-R(7,11));
      if(cfg.kilos)spawnKiloLine(lanes[2],z0-2,5);
      gap=R(16,20);break;}
  }
  return gap*cfg.gapMul;
}

