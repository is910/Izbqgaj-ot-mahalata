    const tb=new THREE.Mesh(new THREE.BoxGeometry(.7,.08,.08),M('#e0622d'));tb.position.y=.85;inner.add(tb);
    for(let i=0;i<3;i++){
      const s=new THREE.Mesh(new THREE.TorusGeometry(.11,.035,8,12),M('#7aa050'));s.position.y=-.5-.14*i;s.rotation.x=PI/2;inner.add(s);
    }
  }else if(type==='mystery'){
    // ASSET [puMystery]: Тайният кил — плачеща торба с "?" — случай добър или саботаж.
    const box=new THREE.Mesh(new THREE.BoxGeometry(.74,.74,.74),new THREE.MeshLambertMaterial({map:makeQuestionTex()}));
    inner.add(box);
  }else if(type==='sjump'){
    // ASSET [puSuperJump]: Пружина със стрела нагоре — супер скок с планиране на падането.
    for(let i=0;i<4;i++){
      const s=new THREE.Mesh(new THREE.TorusGeometry(.26,.06,8,14),M('#d8d3c6'));s.position.y=-.28+.2*i;s.rotation.x=PI/2;inner.add(s);
