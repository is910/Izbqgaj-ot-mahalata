/* ---------- Ефекти (power-ups + саботажи) ---------- */
const fxActive={};
const fxon=k=>fxActive[k]&&fxActive[k].rem>0;
function fxSet(key,label,icon,dur,sab){
  fxActive[key]={rem:dur,dur,label,icon,sab:!!sab};
  rebuildFxHud();
}
function rebuildFxHud(){
  const el=E('fx-list');el.innerHTML='';
  for(const k in fxActive){
    const f=fxActive[k];
    const d=document.createElement('div');
    d.className='fx'+(f.sab?' sab':'');d.dataset.k=k;
    d.style.setProperty('--c',f.sab?'#c23b2e':{speed:'#e8622c',magnet:'#cf4a37',x2:'#e0a83c',jet:'#d97a2e',pogo:'#7aa050',glide:'#f2c14e',reverse:'#c23b2e',repel:'#c23b2e',half:'#c23b2e',chain:'#c23b2e',slip:'#c23b2e'}[k]||'#e8622c');
    d.innerHTML=`<svg class="ring" viewBox="0 0 40 40"><circle class="bgc" cx="20" cy="20" r="17"/><circle class="fgc" cx="20" cy="20" r="17" stroke-dasharray="106.8"/></svg><span class="fx-ic">${svgIcon(f.icon)}</span>`;
    el.appendChild(d);
  }
}
function updateFxHud(){
  const el=E('fx-list');let removed=false;
  for(const k in fxActive){
    const f=fxActive[k];f.rem-=dt_g;
    if(f.rem<=0){delete fxActive[k];removed=true;continue;}
    const d=el.querySelector(`[data-k="${k}"]`);
    if(d)d.querySelector('.fgc').style.strokeDashoffset=106.8*(1-f.rem/f.dur);
  }
  if(removed)rebuildFxHud();
}
function curSab(){return diffKey==='hard'?sabPct:(diffKey==='imposs'?1:0);}
function randomSabKey(){return CH(['reverse','repel','half','chain','slip']);}
