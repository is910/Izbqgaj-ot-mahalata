<!DOCTYPE html>
<html lang="bg">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<title>МАХАЛА SURFERS — Бягай от махалата!</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Russo+One&family=Rubik:wght@400;600;800&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#221812; --paper:#f4e8d2; --accent:#e0622d; --gold:#dda43e;
    --bad:#c23b2e; --good:#7a9d54; --dim:#8a7a64;
  }
  *{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  html,body{height:100%;overflow:hidden;background:#1a120d;font-family:Rubik,sans-serif;color:var(--ink)}
  #game{position:fixed;inset:0;display:block;touch-action:none}
  .hidden{display:none!important}
  button{font-family:inherit;cursor:pointer}

  /* ---------- HUD ---------- */
  #hud{position:fixed;inset:0;pointer-events:none;z-index:10}
  #hud-left{position:absolute;top:14px;left:16px;font-family:'Russo One',sans-serif}
  #dist{font-size:46px;line-height:1;color:var(--paper);text-shadow:0 3px 0 rgba(20,10,5,.65)}
  #dist small{font-size:22px;color:var(--gold)}
  #iron-row{margin-top:6px;display:flex;align-items:center;gap:7px;color:var(--paper);font-size:22px;text-shadow:0 2px 0 rgba(20,10,5,.6)}
  #iron-row svg{width:22px;height:22px;color:var(--gold)}
  #kg{transition:transform .12s}
  #kg.punch{transform:scale(1.35)}
  #mult-badge{font-size:15px;background:var(--gold);color:var(--ink);padding:1px 8px 2px;border:2px solid var(--ink);box-shadow:2px 2px 0 rgba(20,10,5,.5)}
  #mult-badge.bad{background:var(--bad);color:var(--paper)}
  #hud-right{position:absolute;top:14px;right:14px;display:flex;gap:8px;pointer-events:auto}
  .hbtn{width:42px;height:42px;background:var(--paper);border:3px solid var(--ink);box-shadow:3px 3px 0 rgba(20,10,5,.5);display:flex;align-items:center;justify-content:center;color:var(--ink)}
  .hbtn:active{transform:translate(2px,2px);box-shadow:1px 1px 0 rgba(20,10,5,.5)}
  .hbtn svg{width:22px;height:22px}
  #btn-pause{pointer-events:auto}

  #chase-wrap{position:absolute;top:16px;left:50%;transform:translateX(-50%);width:270px;text-align:center;font-family:'Russo One',sans-serif;color:var(--paper);text-shadow:0 2px 0 rgba(20,10,5,.7);transition:opacity .3s}
  #chase-label{font-size:13px;letter-spacing:1px;margin-bottom:4px;color:#ffd9a0}
  #chase-bar{height:14px;border:3px solid var(--ink);background:rgba(20,10,5,.55);box-shadow:3px 3px 0 rgba(20,10,5,.4)}
  #chase-fill{display:block;height:100%;width:0%;background:var(--accent);transition:width .15s linear}
  #chase-bar.danger #chase-fill{background:var(--bad)}
  #chase-wrap.danger #chase-label{color:var(--bad);animation:blink .4s steps(2) infinite}
  @keyframes blink{50%{opacity:.25}}

  #fx-list{position:absolute;bottom:18px;left:50%;transform:translateX(-50%);display:flex;gap:10px}
  .fx{position:relative;width:52px;height:52px}
  .fx svg.ring{position:absolute;inset:0;transform:rotate(-90deg)}
  .fx .bgc{fill:rgba(20,10,5,.55);stroke:rgba(244,232,210,.25);stroke-width:3}
  .fx .fgc{fill:none;stroke:var(--c);stroke-width:4;stroke-linecap:round}
  .fx .fx-ic{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:var(--c)}
  .fx .fx-ic svg{width:26px;height:26px}
  .fx.sab .bgc{fill:rgba(60,10,5,.65)}
  .fx.sab .fgc{stroke:var(--bad)}
  .fx.sab .fx-ic{color:var(--bad);animation:blink .5s steps(2) infinite}

  #toasts{position:absolute;top:26%;left:0;right:0;display:flex;flex-direction:column;align-items:center;gap:6px}
  .toast{font-family:'Russo One',sans-serif;font-size:27px;color:var(--paper);text-shadow:0 3px 0 rgba(20,10,5,.7), -2px 0 0 rgba(20,10,5,.5), 2px 0 0 rgba(20,10,5,.5);animation:tin .25s cubic-bezier(.2,1.6,.4,1)}
  .toast.good{color:var(--gold)}
  .toast.bad{color:#ff7a5e;font-size:24px}
  .toast.info{color:var(--paper);font-size:23px}
  .toast.out{opacity:0;transform:translateY(-14px);transition:all .35s}
  @keyframes tin{from{transform:scale(.4);opacity:0}}

  /* ---------- Оverlays ---------- */
  .overlay{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;z-index:20;background:rgba(24,14,8,.5);padding:16px}
  .panel{background:var(--paper);border:3px solid var(--ink);box-shadow:9px 9px 0 rgba(15,8,4,.55);padding:26px 30px;max-width:540px;width:100%;max-height:96vh;overflow-y:auto}
  h1{font-family:'Russo One',sans-serif;font-size:56px;line-height:.92;letter-spacing:1px}
  h1 em{font-style:normal;color:var(--accent);display:block;font-size:44px}
  .tag{margin:12px 0 18px;font-size:14.5px;color:#5a4a38;font-weight:600}
  .diffs{display:flex;flex-direction:column;gap:8px;margin-bottom:14px}
  .diff{display:flex;align-items:baseline;gap:10px;text-align:left;background:transparent;border:2.5px solid var(--ink);padding:9px 12px;width:100%;transition:transform .08s}
  .diff:hover{transform:translateX(3px)}
  .diff .d-name{font-family:'Russo One',sans-serif;font-size:16px;min-width:118px}
  .diff .d-desc{font-size:12.5px;color:#6a5844;font-weight:600}
  .diff[data-diff=easy]{border-left:10px solid var(--good)}
  .diff[data-diff=medium]{border-left:10px solid var(--gold)}
  .diff[data-diff=hard]{border-left:10px solid var(--accent)}
  .diff[data-diff=imposs]{border-left:10px solid var(--bad)}
  .diff.sel{background:var(--ink);color:var(--paper)}
  .diff.sel .d-desc{color:#cbb895}
  #sab-row{margin-bottom:14px;border:2px dashed #b09878;padding:10px 12px}
  #sab-row label{font-size:13px;font-weight:800;display:block;margin-bottom:6px}
  .sab-line{display:flex;align-items:center;gap:12px}
  .sab-line input{flex:1;accent-color:var(--accent)}
  .sab-line b{font-family:'Russo One',sans-serif;font-size:20px;color:var(--accent);min-width:52px;text-align:right}
  #btn-start,#btn-retry,#btn-resume{width:100%;font-family:'Russo One',sans-serif;font-size:28px;padding:12px;background:var(--accent);color:var(--paper);border:3px solid var(--ink);box-shadow:5px 5px 0 rgba(15,8,4,.55)}
  #btn-start:active,#btn-retry:active,#btn-resume:active{transform:translate(3px,3px);box-shadow:2px 2px 0 rgba(15,8,4,.55)}
  .ghost{font-family:'Russo One',sans-serif;font-size:17px;padding:10px 16px;background:transparent;border:3px solid var(--ink);box-shadow:4px 4px 0 rgba(15,8,4,.4)}
  .ghost:active{transform:translate(2px,2px);box-shadow:1px 1px 0 rgba(15,8,4,.4)}
  .hint{display:flex;flex-wrap:wrap;gap:6px 14px;margin-top:14px;font-size:12.5px;font-weight:600;color:#6a5844}
  kbd{background:var(--ink);color:var(--paper);border-radius:3px;padding:1px 6px;font-family:Rubik,sans-serif;font-size:11px;font-weight:800}
  #best-line{margin-top:12px;font-size:13px;font-weight:800;color:#8a6a3a;text-align:center}

  h2{font-family:'Russo One',sans-serif;font-size:42px;color:var(--bad);line-height:1}
  #over-reason{margin:10px 0 16px;font-weight:600;font-size:14.5px;color:#5a4a38}
  .stats{display:flex;gap:12px;margin-bottom:14px}
  .stats>div{flex:1;border:2.5px solid var(--ink);padding:10px 12px}
  .stats span{display:block;font-size:11px;font-weight:800;letter-spacing:1px;color:#8a7a64}
  .stats b{font-family:'Russo One',sans-serif;font-size:26px}
  #over-best{font-family:'Russo One',sans-serif;color:var(--gold);text-align:center;margin-bottom:14px;font-size:18px}
  .over-btns{display:flex;gap:12px}
  .over-btns #btn-retry{flex:1}
  .panel.small{text-align:center;max-width:340px}
  .panel.small h2{color:var(--ink);margin-bottom:16px}
  .panel.small .over-btns{flex-direction:column}
  @media (max-width:560px){
    h1{font-size:44px} h1 em{font-size:34px}
    #dist{font-size:34px}
    .diff .d-name{min-width:96px;font-size:14px}
    .stats b{font-size:20px}
  }
</style>
</head>
<body>
<canvas id="game"></canvas>

<!-- === HUD по време на игра === -->
<div id="hud" class="hidden">
  <div id="hud-left">
    <div id="dist">0 <small>м</small></div>
    <div id="iron-row">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 6h14v3H5zM5 15h14v3H5zM11 9v6M13 9v6"/></svg>
      <span><b id="kg">0</b> кг</span>
      <span id="mult-badge" class="hidden">×2</span>
    </div>
  </div>
  <div id="hud-right">
    <button id="btn-pause" class="hbtn" title="Пауза"></button>
  </div>
  <div id="chase-wrap" class="hidden">
    <div id="chase-label">ГОНИТБИТЕ НАБЛИЗО!</div>
    <div id="chase-bar"><i id="chase-fill"></i></div>
  </div>
  <div id="fx-list"></div>
  <div id="toasts"></div>
</div>

<!-- === Главно меню === -->
<div id="menu" class="overlay">
  <div class="panel">
    <h1>МАХАЛА<em>SURFERS</em></h1>
    <p class="tag">Взимай килчетата желязо. Дупките само препъват — автобусите не прощават. Гонитбите са по петите ти.</p>
    <div class="diffs">
      <button class="diff" data-diff="easy"><span class="d-name">ЛЕСНО</span><span class="d-desc">Walking simulator. Разходка из квартала — без килове, без гонитби.</span></button>
      <button class="diff" data-diff="medium"><span class="d-name">СРЕДНО</span><span class="d-desc">Килове и по някой power-up. Гонитбите дишат във врата ти.</span></button>
      <button class="diff" data-diff="hard"><span class="d-name">ТРУДНО</span><span class="d-desc">Power-up-ите може да са капани. Шансът за саботаж си го регулираш сам.</span></button>
      <button class="diff" data-diff="imposs"><span class="d-name">НЕВЪЗМОЖНО</span><span class="d-desc">Всеки power-up саботира. Кварталът те мрази. Успех, шампионе.</span></button>
    </div>
    <div id="sab-row" class="hidden">
      <label>ТРУДНО: шанс power-up-ът да те излъже (лош ефект):</label>
      <div class="sab-line"><input type="range" id="sab" min="20" max="50" step="5" value="35"><b id="sab-val">35%</b></div>
    </div>
    <button id="btn-start">БЯГАЙ!</button>
    <div class="hint">
      <span><kbd>←</kbd><kbd>→</kbd> смяна на реда</span>
      <span><kbd>↑</kbd> скок (×2 = double jump!)</span>
      <span><kbd>↓</kbd> пързална / бързо падане</span>
      <span><kbd>P</kbd> пауза</span>
      <span>на телефон: свайпове</span>
    </div>
    <div id="best-line"></div>
  </div>
</div>

<!-- === Край на играта === -->
<div id="over" class="overlay hidden">
  <div class="panel">
    <h2 id="over-title">ХВАНАХА ТЕ!</h2>
    <p id="over-reason"></p>
    <div class="stats">
      <div><span>ДИСТАНЦИЯ</span><b id="over-dist">0 м</b></div>
      <div><span>ЖЕЛЯЗО</span><b id="over-kg">0 кг</b></div>
    </div>
    <div id="over-best"></div>
    <div class="over-btns">
      <button id="btn-retry">ОЩЕ ВЕДНЪЖ</button>
      <button id="btn-menu" class="ghost">КЪМ МАХАЛАТА</button>
    </div>
  </div>
</div>

<!-- === Пауза === -->
<div id="paused" class="overlay hidden">
  <div class="panel small">
    <h2>ПАУЗА</h2>
    <div class="over-btns">
      <button id="btn-resume">ПРОДЪЛЖИ</button>
      <button id="btn-quit" class="ghost">ОТКАЖИ</button>
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
'use strict';
/* =====================================================================
   СПИСЪК С АСЕТИ — всяко заглушка в кода е маркирана с коментар:
   // ASSET [име]: описание с едно изречение.
   Замени геометрията-заглушка с истински 3D модел, като запазиш
   приблизителните размери и позицията на групата (и castShadow).
   ===================================================================== */

/* ---------- Помощници ---------- */
const PI=Math.PI;
const R=(a,b)=>a+Math.random()*(b-a);
const RI=(a,b)=>Math.floor(R(a,b+1));
const CH=a=>a[Math.floor(Math.random()*a.length)];
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const lerp=(a,b,t)=>a+(b-a)*t;
const E=id=>document.getElementById(id);
const lerpA=(v,tgt,rate)=>v+(tgt-v)*Math.min(1,rate);
function shuffle(a){a=a.slice();for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;}
function pickW(list){let s=0;for(const[,w]of list)s+=w;let r=Math.random()*s;for(const[k,w]of list){r-=w;if(r<=0)return k;}return list[0][0];}
function save(k,v){try{localStorage.setItem('ms_'+k,JSON.stringify(v));}catch(e){}}
function load(k,d){try{const v=localStorage.getItem('ms_'+k);return v==null?d:JSON.parse(v);}catch(e){return d;}}

/* ---------- Процедурни звуци (без файлове) ---------- */
const Sfx=(()=>{
  let ctx=null,master=null,noiseBuf=null,muted=load('muted',false);
  function ensure(){
    if(!ctx){
      const AC=window.AudioContext||window.webkitAudioContext;if(!AC)return false;
      ctx=new AC();master=ctx.createGain();master.gain.value=muted?0:0.5;master.connect(ctx.destination);
      noiseBuf=ctx.createBuffer(1,ctx.sampleRate*1.2,ctx.sampleRate);
      const d=noiseBuf.getChannelData(0);for(let i=0;i<d.length;i++)d[i]=Math.random()*2-1;
    }
    if(ctx.state==='suspended')ctx.resume();
    return true;
  }
  function tone(f0,f1,dur,type,vol,delay=0){
    if(!ensure())return;const t=ctx.currentTime+delay;
    const o=ctx.createOscillator(),g=ctx.createGain();
    o.type=type;o.frequency.setValueAtTime(f0,t);o.frequency.exponentialRampToValueAtTime(Math.max(1,f1),t+dur);
    g.gain.setValueAtTime(vol,t);g.gain.exponentialRampToValueAtTime(0.0001,t+dur);
    o.connect(g);g.connect(master);o.start(t);o.stop(t+dur+0.03);
  }
  function noise(dur,vol,fc,q=1){
    if(!ensure())return;const t=ctx.currentTime;
    const s=ctx.createBufferSource();s.buffer=noiseBuf;s.loop=true;
    const f=ctx.createBiquadFilter();f.type='lowpass';f.frequency.value=fc;f.Q.value=q;
    const g=ctx.createGain();g.gain.setValueAtTime(vol,t);g.gain.exponentialRampToValueAtTime(0.0001,t+dur);
    s.connect(f);f.connect(g);g.connect(master);s.start(t);s.stop(t+dur+0.05);
  }
  return{
    unlock(){ensure();},
    setMuted(m){muted=m;if(master)master.gain.value=m?0:0.5;},
    get muted(){return muted;},
    jump(){tone(250,540,.16,'sine',.35);},
    djump(){tone(330,780,.18,'sine',.32);tone(520,980,.12,'triangle',.16,.03);},
    kilo(){const f=R(950,1400);tone(f,f*.99,.07,'triangle',.2);tone(f*1.52,f*1.5,.11,'triangle',.14,.02);},
    power(){[523,659,784,1046].forEach((f,i)=>tone(f,f,.14,'triangle',.2,i*.07));},
    bad(){tone(320,150,.35,'sawtooth',.22);tone(302,158,.35,'square',.1,.02);},
    trip(){noise(.25,.38,700);tone(180,80,.2,'sine',.28);},
    crash(){noise(.5,.5,900);tone(150,40,.5,'sine',.45);},
    slide(){noise(.18,.16,1500,2);},
    whoosh(){noise(.22,.18,2300,3);}
  };
})();

/* ---------- Конфигурации на трудностите ---------- */
const DIFFS={
  easy:  {speed:7,  max:9,  kilos:false,powers:[],                        buses:false,holes:true, chase:false,gapMul:1.6, busMax:0,penalty:.9},
  medium:{speed:12, max:24, kilos:true, powers:['magnet','x2','sjump'],  buses:true, holes:true, chase:true, gapMul:1.15,busMax:1,penalty:.55},
  hard:  {speed:13.5,max:27,kilos:true, powers:['speed','magnet','x2','jet','pogo','mystery','sjump'],buses:true,holes:true,chase:true,gapMul:1.0,busMax:2,penalty:.55},
  imposs:{speed:16, max:33, kilos:true, powers:['speed','magnet','x2','jet','pogo','mystery','sjump'],buses:true,holes:true,chase:true,gapMul:.72,busMax:2,penalty:.5}
};
const DIFF_NAMES={easy:'ЛЕСНО',medium:'СРЕДНО',hard:'ТРУДНО',imposs:'НЕВЪЗМОЖНО'};

/* ---------- Power-ups и саботажи ---------- */
const POWERS={
  speed:  {label:'КОЛЕТО — СКОРОСТ!',icon:'wheel',  dur:5, sab:{key:'reverse',label:'ОБЪРНАТИ КОНТРОЛИ',dur:6}},
  magnet: {label:'МАГНЕТ',          icon:'magnet', dur:8, sab:{key:'repel',  label:'БЛЪСКАЩ МАГНЕТ',dur:6}},
  x2:     {label:'КИЛОВЕ ×2',       icon:'x2',     dur:10,sab:{key:'half',   label:'КРАДЕЦ НА КИЛОВЕ ×½',dur:10}},
  jet:    {label:'ДЖЕТПАК',         icon:'jet',    dur:6, sab:{key:'chain',  label:'ВЕРИГА — БЕЗ СКОК!',dur:7}},
  pogo:   {label:'ПОГУ СТИК',       icon:'pogo',   dur:6, sab:{key:'slip',   label:'ХЛЪЗГАВ ПОГУ',dur:6}},
  mystery:{label:'ТАЙНЕН КИЛ',      icon:'mystery',dur:0, sab:null},
  sjump:  {label:'СУПЕР СКОК',      icon:'sjump',  dur:0, sab:{key:'slam',   label:'ОБЪРНАТА ПРУЖИНА',dur:0}}
};
const SAB_META={
  reverse:{label:'ОБЪРНАТИ КОНТРОЛИ',icon:'reverse'},
  repel:  {label:'БЛЪСКАЩ МАГНЕТ',   icon:'magnet'},
  half:   {label:'КИЛОВЕ ×½',        icon:'half'},
  chain:  {label:'БЕЗ СКОК!',        icon:'chain'},
  slip:   {label:'ХЛЪЗГАВ ПОГУ',     icon:'slip'},
};

/* ---------- SVG иконки за HUD ---------- */
const ICONS={
  wheel:'<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="2.2"/><path d="M12 3.5v6M12 14.5v6M3.5 12h6M14.5 12h6"/>',
  magnet:'<path d="M7 4v7a5 5 0 0 0 10 0V4"/><path d="M6 4h2.6M15.4 4H18" stroke-width="3.4"/>',
  x2:'<text x="12" y="17.5" text-anchor="middle" font-size="13.5" font-weight="bold" fill="currentColor" stroke="none">2×</text>',
  half:'<text x="12" y="17.5" text-anchor="middle" font-size="15" font-weight="bold" fill="currentColor" stroke="none">½</text>',
  jet:'<rect x="7" y="3" width="4" height="11" rx="1"/><rect x="13" y="3" width="4" height="11" rx="1"/><path d="M9 16c0 2.5-1 4-1 4M15 16c0 2.5 1 4 1 4" stroke-width="2.4"/>',
  pogo:'<path d="M12 2v4M8 4h8"/><path d="M12 7l-2 1.6 4 1.8-4 1.8 4 1.8-2 1.6"/><path d="M9 19h6"/>',
  mystery:'<text x="12" y="18" text-anchor="middle" font-size="16" font-weight="bold" fill="currentColor" stroke="none">?</text>',
  sjump:'<path d="M6 12.5l6-6 6 6M6 20l6-6 6 6"/>',
  reverse:'<path d="M7 8h10M17 8l-3.4-3.4M17 8l-3.4 3.4"/><path d="M17 16H7M7 16l3.4-3.4M7 16l3.4 3.4"/>',
  chain:'<rect x="7" y="16" width="10" height="4.5" rx="1.4"/><path d="M12 16V6M8.6 9h6.8"/>',
  slip:'<path d="M3 12c3-3.4 6-3.4 9 0s6 3.4 9 0"/><path d="M12 8V3M12 3l-2.6 2.4M12 3l2.6 2.4"/>',
  pause:'<path d="M8 4v16M16 4v16" stroke-width="4"/>',
};
const svgIcon=n=>`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${ICONS[n]}</svg>`;
E('btn-pause').innerHTML=svgIcon('pause');

/* ---------- Global game state ---------- */
let scene,camera,renderer;
