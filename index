// ASSET [cloudTexture]: Дълга тъмна облак- лента на фона на залеза.
function makeCloudTex(){
  return texCanvas(256,64,(g,w,h)=>{
    const gr=g.createLinearGradient(0,0,w,0);
    gr.addColorStop(0,'rgba(90,70,60,0)');gr.addColorStop(.5,'rgba(90,70,60,.55)');gr.addColorStop(1,'rgba(90,70,60,0)');
    g.fillStyle=gr;g.fillRect(0,0,w,h);
  });
}

