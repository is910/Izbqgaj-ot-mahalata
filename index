  Sfx.bad();
  if(key==='slam'){
    if(P.y>0.05){P.vy=-34;P.slamPending=true;}
    else doStagger(0.22);
    toast('САБОТАЖ: '+POWERS.sjump.sab.label,'bad');
    return;
  }
  const meta=SAB_META[key];
  const dur={reverse:6,repel:6,half:10,chain:7,slip:6}[key];
  fxSet(key,meta.label,meta.icon,dur,true);
  if(key==='slip')P.slipTick=0;
  toast('САБОТАЖ: '+meta.label,'bad');
}
function applyPowerItem(type){
  if(type==='mystery'){
    if(Math.random()<curSab()){
      const k=randomSabKey();
      if(k==='slam'){applySabotage('slam');toast('ТАЙНА КУТИЯ…','info');}
      else{applySabotage(k);toast('ТАЙНА КУТИЯ…','info');}
    }else{
      const good=CH(cfg.powers.filter(p=>p!=='mystery'));
      applyGood(good);toast('ТАЙНА КУТИЯ: '+POWERS[good].label,'good');
    }
    return;
  }
  if(Math.random()<curSab()){applySabotage(POWERS[type].sab.key);}
  else{applyGood(type);toast(POWERS[type].label,'good');}
}

/* ---------- Действия на играча ---------- */
function moveLane(dir){
  if(state!=='running')return;
  let d=dir;if(fxon('reverse'))d=-d;
  const nl=clamp(P.lane+d,0,2);
  if(nl!==P.lane){P.lane=nl;Sfx.whoosh();}
}
function tryJump(){
  if(state!=='running')return;
  if(fxon('chain')){Sfx.bad();return;}
  if(P.onGround){P.vy=11.2;P.jumps=1;P.onGround=false;P.wasAir=true;Sfx.jump();}
  else if(P.jumps<2){P.vy=11.8;P.jumps=2;Sfx.djump();ringFlash(P.x,P.y);}
}
function trySlide(){
  if(state!=='running')return;
  if(P.y>0.05){P.vy=Math.min(P.vy,-27);}
  else{P.slideT=.7;Sfx.slide();}
}
function doStagger(chaseAdd){
  P.tripT=1.0;speedPenalty=cfg.penalty;
  if(cfg.chase)chase=Math.min(1,chase+chaseAdd);
  shakeMag=Math.max(shakeMag,.6);shakeRoll=R(-.15,.15);
  Sfx.trip();
}
function trip(){
  if(P.tripT>0||P.holeCd>0||fxon('jet')||fxon('pogo'))return;
  P.tripT=.95;P.holeCd=1.6;speedPenalty=cfg.penalty;
  if(cfg.chase)chase=Math.min(1,chase+.34);
  shakeMag=Math.max(shakeMag,.55);shakeRoll=R(-.14,.14);
  Sfx.trip();toast('ДУПКА!','bad');
}
function crash(reason){
  if(state!=='running')return;
  deathReason=reason;state='dying';deathT=0;
  Sfx.crash();shakeMag=1.2;shakeRoll=R(-.1,.1);
}

/* ---------- Ъпдейти ---------- */
let dt_g=0;
function moveWorld(dz,dt){
  const kill=[];
  for(const m of movers){
    m.mesh.position.z+=dz;
    const k=m.kind;
    if(k==='kilo'){
      m.mesh.rotation.y+=dt*2.2;
      m.mesh.userData.inner.position.y=m.baseY+Math.sin(T*3+m.phase)*.09;
    }else if(k==='pw'){
      const u=m.mesh.userData;
      u.inner.rotation.y+=dt*1.7;
      u.inner.position.y=1.15+Math.sin(T*2.4+m.phase)*.12;
      u.ring.material.opacity=.35+Math.sin(T*4+m.phase)*.2;
      if(u.flame)u.flame.scale.y=.7+Math.sin(T*30)*.3;
    }
    if(m.mesh.position.z>KILL_Z)kill.push(m);
  }
  for(const m of kill){release(m.rk,m.mesh);movers.splice(movers.indexOf(m),1);}
}
function spawnScenery(dz,zOverride){
  const z=zOverride!=null?zOverride:SPAWN_Z;
  let did=false;
  sideAcc+=dz;while(sideAcc>=sideGap){sideAcc-=sideGap;sideGap=R(11,17);spawnSideProp(-1,z);spawnSideProp(1,z);did=true;}
  poleAcc+=dz;while(poleAcc>=26){poleAcc-=26;spawnPolePair(z);did=true;}
  panelAcc+=dz;while(panelAcc>=panelGap){panelAcc-=panelGap;panelGap=R(28,38);if(Math.random()<.8)spawnPanel(CH([-1,1]),z);did=true;}
  farAcc+=dz;while(farAcc>=farGap){farAcc-=farGap;farGap=R(26,40);spawnFar(-1,z);spawnFar(1,z+R(-6,6));did=true;}
  markAcc+=dz;while(markAcc>=4.2){markAcc-=4.2;spawnMark(z);did=true;}
  return did;
}
function updatePlayer(dt){
  P.holeCd=Math.max(0,P.holeCd-dt);
  P.x=lerpA(P.x,LANE_X[P.lane],dt*(P.tripT>0?5:10));
  P.onGround=false;
  if(fxon('jet')){
    P.y=lerpA(P.y,6.4,dt*3);P.vy=0;P.wasAir=true;P.jumps=1;
  }else{
    let g=30;
    if(fxon('glide')&&P.vy<0)g=9;
    if(fxon('chain')&&P.vy<0)g=46;
    P.vy-=g*dt;P.y+=P.vy*dt;
    if(P.y<=0){
      P.y=0;
      if(P.slamPending){P.slamPending=false;P.vy=0;doStagger(0.25);shakeMag=Math.max(shakeMag,.7);}
      else if(fxon('pogo')&&P.wasAir){P.vy=15;Sfx.jump();}
      else{P.vy=0;P.onGround=true;P.wasAir=false;P.jumps=0;}
    }
  }
  if(fxon('slip')){
    P.slipTick-=dt;
    if(P.slipTick<=0){P.slipTick=.85;P.lane=CH([0,1,2].filter(l=>l!==P.lane));shakeMag=Math.max(shakeMag,.2);}
  }
  P.root.position.set(P.x,P.y,0);
  animateHero(dt);
}
function animateHero(dt){
  const u=P.ud,inner=u.inner;
  P.jetMesh.visible=fxon('jet');P.pogoMesh.visible=fxon('pogo');
  if(P.jetFlame)P.jetFlame.scale.y=.7+Math.sin(T*30)*.3;
  if(P.tripT>0){
    P.tripT-=dt;
    inner.rotation.x=-.55+Math.sin(T*26)*.2;inner.position.y=0;
    u.legL.rotation.x=Math.sin(T*18)*.8;u.legR.rotation.x=-Math.sin(T*18)*.8;
    u.armL.rotation.x=Math.sin(T*22)*1.6;u.armR.rotation.x=-Math.sin(T*22)*1.6;
  }else if(P.slideT>0){
    P.slideT-=dt;
    inner.rotation.x=-1.05;inner.position.y=.3;
    u.legL.rotation.x=-.3;u.legR.rotation.x=-.2;u.armL.rotation.x=.8;u.armR.rotation.x=.8;
  }else if(fxon('jet')){
    inner.rotation.x=-.3;inner.position.y=0;
    u.legL.rotation.x=.5;u.legR.rotation.x=.35;u.armL.rotation.x=-.6;u.armR.rotation.x=-.6;
  }else if(fxon('pogo')&&!P.onGround){
    inner.rotation.x=-.1;inner.position.y=0;
    u.legL.rotation.x=.9;u.legR.rotation.x=.75;u.armL.rotation.x=-.9;u.armR.rotation.x=-.9;
  }else if(!P.onGround){
    inner.rotation.x=-.2;inner.position.y=0;
    u.legL.rotation.x=.65;u.legR.rotation.x=-.45;
    const a=P.vy>0?-2.3:-.7;
    u.armL.rotation.x=a;u.armR.rotation.x=a;
  }else{
    inner.position.y=Math.abs(Math.cos(P.runPhase))*.07;
    animateRunner(P.root,P.runPhase,1);
  }
  P.runPhase+=dt*(10+speed*.35);
}
function updateCollisions(){
  const pc=new THREE.Vector3(P.x,P.y+1,0);
  const busInv=fxon('jet')||fxon('pogo');
  for(const m of movers){
    const z=m.mesh.position.z;
    if(m.kind==='bus'&&!busInv){
      if(z>-4.2&&z<4.2&&Math.abs(P.x-LANE_X[m.lane])<1.15&&P.y<2.55){crash('bus');return;}
    }else if(m.kind==='hole'){
      if(P.y<.45&&P.holeCd<=0&&!fxon('jet')&&!fxon('pogo')&&Math.abs(z)<.95&&Math.abs(P.x-LANE_X[m.lane])<.95){trip();}
    }else if(m.kind==='kilo'){
      const d=m.mesh.position.distanceTo(pc);
      if(fxon('magnet')||fxon('jet')){
        if(d<(fxon('jet')?13:7))m.mesh.position.lerp(pc,Math.min(1,dt_g*(fxon('jet')?11:7)));
      }else if(fxon('repel')&&d<5.5){
        const dir=m.mesh.position.clone().sub(pc).normalize();
        m.mesh.position.addScaledVector(dir,dt_g*8);
      }
      if(d<1.3){
        let gain=m.kgVal;
        if(fxon('x2'))gain*=2;
        if(fxon('half'))gain*=.5;
        kg+=Math.round(gain);
        Sfx.kilo();
        const el=E('kg');el.classList.remove('punch');void el.offsetWidth;el.classList.add('punch');
        release(m.rk,m.mesh);movers.splice(movers.indexOf(m),1);
      }
    }else if(m.kind==='pw'){
      const d=m.mesh.position.distanceTo(pc);
      if(d<1.4){
        applyPowerItem(m.type);
        release(m.rk,m.mesh);movers.splice(movers.indexOf(m),1);
      }
    }
  }
}
function updateChasers(dt){
  if(!cfg.chase){chasers.group.visible=false;return;}
  chasers.group.visible=true;
  chase=Math.max(0,chase-dt*.05);
  if(['reverse','repel','half','chain','slip'].some(fxon))chase=Math.min(1,chase+dt*.013);
  if(chase>=1){crash('caught');return;}
  const cz=lerp(9.5,1.8,chase*chase);
  chasers.group.position.z=lerpA(chasers.group.position.z,cz,dt*3);
  chasers.group.position.x=Math.sin(T*1.7)*.25;
  chasers.list.forEach((c,i)=>{
    animateRunner(c,T*11+i*2.2,1);
    if(chase>.55){c.userData.armL.rotation.x=-1.5+Math.sin(T*14)*.2;c.userData.armR.rotation.x=-1.5-Math.sin(T*14)*.2;}
  });
}
function updateCamera(dt){
  if(state==='menu'){
    camera.position.x=Math.sin(T*.22)*2.2;
    camera.position.y=4.6;camera.position.z=10.5;
    camera.lookAt(0,1.9,-16);
    camera.fov=lerpA(camera.fov,55,dt*2);camera.updateProjectionMatrix();
    return;
  }
  camX=lerpA(camX,P.x*.5,dt*6);
  camera.position.x=camX+(Math.random()-.5)*shakeMag*.5;
  camera.position.y=5.3+P.y*.3+(Math.random()-.5)*shakeMag*.35;
  camera.position.z=9;
  camera.lookAt(P.x*.7,1.5+P.y*.35,-12);
  camera.rotation.z+=shakeRoll;
  shakeMag*=Math.exp(-5*dt);shakeRoll*=Math.exp(-4*dt);
  const tf=58+speed*.32+(fxon('speed')?5:0);
  camera.fov=lerpA(camera.fov,tf,dt*3);camera.updateProjectionMatrix();
}
function updateRings(dt){
  for(const f of ringFlashes){
    if(!f.m.visible)continue;
    f.t+=dt*2.4;
    if(f.t>=1){f.m.visible=false;continue;}
    f.m.scale.setScalar(.6+f.t*1.6);
    f.m.material.opacity=.6*(1-f.t);
  }
}
function updateHud(){
  E('dist').innerHTML=Math.floor(dist)+' <small>м</small>';
  E('kg').textContent=Math.round(kg);
  const mb=E('mult-badge');
  if(fxon('half')){mb.classList.remove('hidden');mb.classList.add('bad');mb.textContent='×½';}
  else if(fxon('x2')){mb.classList.remove('hidden');mb.classList.remove('bad');mb.textContent='×2';}
  else mb.classList.add('hidden');
  const cw=E('chase-wrap');
  if(cfg.chase&&chase>.03){
    cw.classList.remove('hidden');cw.style.opacity=1;
    E('chase-fill').style.width=(chase*100)+'%';
    cw.classList.toggle('danger',chase>.6);
    E('chase-bar').classList.toggle('danger',chase>.6);
  }else cw.style.opacity=0;
}
function updateRunning(dt){
  const base=cfg.speed+(cfg.max-cfg.speed)*clamp(dist/1600,0,1);
  speedPenalty+=(1-speedPenalty)*Math.min(1,dt*1.3);
  speed=base*(fxon('speed')?1.5:1)*speedPenalty;
  const dz=speed*dt;dist+=dz;
  moveWorld(dz,dt);spawnScenery(dz);
  patDist-=dz;if(patDist<=0)patDist=spawnPattern();
  updatePlayer(dt);updateFxTimers(dt);updateCollisions();updateChasers(dt);updateHud();
}
let fxTimerDt=0;
function updateFxTimers(dt){dt_g=dt;fxTimerDt=dt;updateFxHud();}
function updateDying(dt){
  deathT+=dt;
  speed*=Math.exp(-4.5*dt);
  moveWorld(speed*dt,dt);
  chasers.group.position.z=lerpA(chasers.group.position.z,1.1,dt*4);
  chasers.list.forEach(c=>{c.userData.armL.rotation.x=-2.4;c.userData.armR.rotation.x=-2.4;});
  if(deathReason==='bus'){
    P.ud.inner.rotation.x=lerpA(P.ud.inner.rotation.x,1.3,dt*5);
    P.y=Math.max(0,P.y+P.vy*dt);P.vy-=30*dt;
    P.root.position.set(P.x,P.y,0);
  }else{
    P.ud.armL.rotation.x=-2.5;P.ud.armR.rotation.x=-2.5;
  }
  if(deathT>1.15)showOver();
}

/* ---------- Toast съобщения ---------- */
function toast(txt,kind){
  const d=document.createElement('div');
  d.className='toast '+(kind||'info');d.textContent=txt;
  E('toasts').appendChild(d);
  setTimeout(()=>d.classList.add('out'),1100);
  setTimeout(()=>d.remove(),1500);
}

/* ---------- UI: меню / старт / край ---------- */
function updateBestLine(){
  const b=load('best_'+diffKey,null);
  E('best-line').textContent=b?`Рекорд (${DIFF_NAMES[diffKey]}): ${b.m} м / ${b.kg} кг желязо`:'Рекорд: още няма — бягай пръв!';
}
function selectDiff(k){
  diffKey=k;save('diff',k);
  document.querySelectorAll('.diff').forEach(b=>b.classList.toggle('sel',b.dataset.diff===k));
  E('sab-row').classList.toggle('hidden',k!=='hard');
  updateBestLine();
}
function clearHazards(){
  movers=movers.filter(m=>{
    if(m.kind==='bus'||m.kind==='hole'||m.kind==='kilo'||m.kind==='pw'){
      release(m.rk,m.mesh);return false;
    }
    return true;
  });
}
function startGame(){
  Sfx.unlock();
  cfg=DIFFS[diffKey];
  clearHazards();
  dist=0;kg=0;chase=0;speedPenalty=1;patDist=26;
  for(const k in fxActive)delete fxActive[k];rebuildFxHud();
  Object.assign(P,{lane:1,x:0,y:0,vy:0,jumps:0,onGround:true,wasAir:false,tripT:0,slideT:0,holeCd:0,slamPending:false,runPhase:0,slipTick:0});
  P.ud.inner.rotation.x=0;P.ud.inner.position.y=0;
  chasers.group.position.z=9.5;chasers.group.visible=cfg.chase;
  deathT=0;
  state='running';
  E('menu').classList.add('hidden');E('over').classList.add('hidden');E('paused').classList.add('hidden');
  E('hud').classList.remove('hidden');
  updateHud();toast('БЯГАЙ!','good');
}
function showOver(){
  state='over';
  const m=Math.floor(dist),k=Math.round(kg);
  const best=load('best_'+diffKey,{m:0,kg:0});
  bestFlash=m>best.m;
  if(m>best.m||k>best.kg){best.m=Math.max(best.m,m);best.kg=Math.max(best.kg,k);save('best_'+diffKey,best);}
  E('over-title').textContent=deathReason==='bus'?'БЛЪСНА СЕ!':'ХВАНАХА ТЕ!';
  E('over-reason').textContent=deathReason==='bus'
    ?'Връщаш се в автобуса. С главата. На линия '+CH(BUS_NUMS)+'.'
    :'Гонитбите те настигнаха на '+m+'-ия метър. Следващия път гледай къде стъпваш.';
  E('over-dist').textContent=m+' м';
  E('over-kg').textContent=k+' кг';
  E('over-best').textContent=bestFlash?'★ НОВ РЕКОРД НА МАХАЛАТА! ★':'Рекорд: '+best.m+' м / '+best.kg+' кг';
  E('over').classList.remove('hidden');
  E('hud').classList.add('hidden');
}
function toMenu(){
  state='menu';clearHazards();
  E('over').classList.add('hidden');E('paused').classList.add('hidden');
  E('hud').classList.add('hidden');E('menu').classList.remove('hidden');
  chasers.group.visible=false;updateBestLine();
}
function pauseGame(){if(state!=='running')return;state='paused';E('paused').classList.remove('hidden');}
function resumeGame(){if(state!=='paused')return;state='running';E('paused').classList.add('hidden');last=performance.now();}

/* ---------- Вход ---------- */
function bindInput(){
  addEventListener('keydown',e=>{
    if(e.repeat)return;
    const k=e.key;
    if(['ArrowLeft','ArrowRight','ArrowUp','ArrowDown',' '].includes(k))e.preventDefault();
    if(k==='ArrowLeft'||k==='a'||k==='A')moveLane(-1);
    else if(k==='ArrowRight'||k==='d'||k==='D')moveLane(1);
    else if(k==='ArrowUp'||k==='w'||k==='W'||k===' ')tryJump();
    else if(k==='ArrowDown'||k==='s'||k==='S')trySlide();
    else if(k==='p'||k==='P'||k==='Escape'){state==='running'?pauseGame():state==='paused'&&resumeGame();}
    else if(k==='m'||k==='M')toggleMute();
  });
  let tx=0,ty=0,tt=0,used=false;
  const cv=E('game');
  addEventListener('touchstart',e=>{const t=e.touches[0];tx=t.clientX;ty=t.clientY;tt=performance.now();used=false;},{passive:true});
  addEventListener('touchmove',e=>{
    e.preventDefault();
    if(used)return;
    const t=e.touches[0],dx=t.clientX-tx,dy=t.clientY-ty;
    if(Math.abs(dx)<38&&Math.abs(dy)<38)return;
    used=true;
    if(Math.abs(dx)>Math.abs(dy))moveLane(dx>0?1:-1);
    else dy<0?tryJump():trySlide();
  },{passive:false});
  addEventListener('touchend',()=>{
    if(!used&&performance.now()-tt<250&&state==='running')tryJump();
  });
  addEventListener('blur',()=>{if(state==='running')pauseGame();});
  document.querySelectorAll('.diff').forEach(b=>b.addEventListener('click',()=>{Sfx.unlock();selectDiff(b.dataset.diff);}));
  E('sab').addEventListener('input',e=>{sabPct=e.target.value/100;E('sab-val').textContent=e.target.value+'%';save('sab',sabPct);});
  E('btn-start').addEventListener('click',startGame);
  E('btn-retry').addEventListener('click',startGame);
  E('btn-menu').addEventListener('click',toMenu);
  E('btn-quit').addEventListener('click',toMenu);
  E('btn-resume').addEventListener('click',resumeGame);
  E('btn-pause').addEventListener('click',pauseGame);
  addEventListener('resize',()=>{
    camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();
    renderer.setSize(innerWidth,innerHeight);
  });
}
function toggleMute(){
  Sfx.setMuted(!Sfx.muted);save('muted',Sfx.muted);
}

/* ---------- Главен цикъл ---------- */
let last=performance.now();
function loop(now){
  requestAnimationFrame(loop);
  const dt=Math.min(.05,(now-last)/1000);last=now;
  if(state==='paused'){renderer.render(scene,camera);return;}
  T+=dt;dt_g=dt;
  if(state==='menu'){
    speed=6;moveWorld(speed*dt,dt);spawnScenery(speed*dt);
    P.runPhase+=dt*10;P.root.position.set(0,0,0);animateRunner(P.root,P.runPhase,1);
  }else if(state==='running'){
    updateRunning(dt);
  }else if(state==='dying'){
    updateDying(dt);
  }
  updateRings(dt);
  updateCamera(dt);
  renderer.render(scene,camera);
}

/* ---------- Буте --- звук ---------- */
(function makeSoundBtn(){
  const b=document.createElement('button');b.className='hbtn';b.id='btn-sound';
  b.style.position='fixed';b.style.top='14px';b.style.right='14px';b.style.zIndex='30';
  const upd=()=>b.innerHTML=Sfx.muted
    ?'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor" stroke="none"/><path d="M16 8l6 8M22 8l-6 8"/></svg>'
    :'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor" stroke="none"/><path d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12"/></svg>';
  b.addEventListener('click',()=>{Sfx.unlock();toggleMute();upd();});
  upd();document.body.appendChild(b);
  E('hud-right').style.right='64px';
})();

/* ---------- Boot ---------- */
function prefill(){
  let z=-172;while(z<14){spawnSideProp(-1,z);spawnSideProp(1,z+R(-4,4));z+=R(11,17);}
  z=-172;while(z<14){spawnPolePair(z);z+=26;}
  z=-160;while(z<10){spawnPanel(CH([-1,1]),z);z+=R(28,38);}
  z=-170;while(z<10){spawnFar(-1,z);spawnFar(1,z+R(-6,6));z+=R(26,40);}
  z=-172;while(z<14){spawnMark(z);z+=4.2;}
}
addEventListener('load',()=>{
  Promise.race([document.fonts.ready,new Promise(r=>setTimeout(r,1300))]).then(()=>{
    initThree();
    buildPlayer();buildChasers();
    bindInput();
    selectDiff(diffKey);
    const sv=load('sab',0.35);sabPct=clamp(sv,.2,.5);
    E('sab').value=Math.round(sabPct*100);E('sab-val').textContent=Math.round(sabPct*100)+'%';
    prefill();
    last=performance.now();
    requestAnimationFrame(loop);
  });
});
</script>
